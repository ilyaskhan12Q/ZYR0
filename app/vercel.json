{
  "rewrites": [
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/school", "destination": "/index.html" },
    { "source": "/edu", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/internships", "destination": "/index.html" },
    { "source": "/internships/:id", "destination": "/index.html" },
    { "source": "/internships/browse", "destination": "/index.html" },
    { "source": "/companies", "destination": "/index.html" },
    { "source": "/companies/:id", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/careers/apply", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/verify", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" },
    { "source": "/student/:path*", "destination": "/index.html" },
    { "source": "/company/:path*", "destination": "/index.html" },
    { "source": "/mentor/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "routes": [
    { "src": "/(.*)", "status": 404 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.supabase.co https://static.cloudflareinsights.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vercel.live; font-src 'self' https://fonts.gstatic.com data: https://vercel.live; img-src 'self' data: https://ui-avatars.com https://i.pravatar.cc https://api.qrserver.com https://*.supabase.co https://lh3.googleusercontent.com https://*.licdn.com https://vercel.live https://vercel.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.qrserver.com https://fonts.googleapis.com https://fonts.gstatic.com https://cloudflareinsights.com https://vercel.live wss://ws-us3.pusher.com; frame-src 'self' https://vercel.live; frame-ancestors 'none';" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
